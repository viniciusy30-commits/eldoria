<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.eldoria.app.game.GameView
        android:id="@+id/game_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Painel de status -->
    <LinearLayout
        android:id="@+id/painel_topo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_painel"
        android:orientation="vertical"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_nivel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nv. 1"
                android:textColor="@color/on_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@string/ouro"
                android:src="@drawable/ic_ouro" />

            <TextView
                android:id="@+id/text_ouro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="0"
                android:textColor="@color/accent"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/botao_configuracoes"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/botao_configuracoes"
                android:src="@drawable/ic_configuracoes"
                app:tint="@color/on_primary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_barra_fundo"
            android:orientation="horizontal">

            <View
                android:id="@+id/barra_vida"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_barra_vida" />

            <View
                android:id="@+id/barra_vida_resto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_vida"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="100 / 100"
            android:textColor="@color/on_primary"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_barra_fundo"
            android:orientation="horizontal">

            <View
                android:id="@+id/barra_xp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_barra_xp" />

            <View
                android:id="@+id/barra_xp_resto"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_xp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="0 / 80 XP"
            android:textColor="#DDFFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Joystick de movimento -->
    <com.eldoria.app.ui.JoystickView
        android:id="@+id/joystick"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="20dp" />

    <!-- Botões de ação -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/botao_pocao"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:background="@drawable/bg_botao_pocao"
            android:contentDescription="@string/botao_pocao"
            android:src="@drawable/ic_pocao" />

        <TextView
            android:id="@+id/text_pocoes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_painel"
            android:paddingStart="10dp"
            android:paddingTop="2dp"
            android:paddingEnd="10dp"
            android:paddingBottom="2dp"
            android:text="Poções: 5"
            android:textColor="@color/on_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/botao_atacar"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_botao_circular"
            android:contentDescription="@string/botao_atacar"
            android:src="@drawable/ic_atacar" />
    </LinearLayout>

</FrameLayout>
